        "updatedAt": { "type": "string", "maxLength": 50, "description": "Last update ISO timestamp" }
      },
      "required": ["id", "nameAr"]
    },
    "announcements": {
      "title": "Announcements & Ads",
      "description": "Website news, announcements and advertisement banners",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Announcement ID" },
