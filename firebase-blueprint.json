{
  "entities": {
    "admins": {
      "title": "Verified Platform Administrators",
      "description": "Authorized admin role verification records keyed by Firebase Auth UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Admin Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "maxLength": 254, "description": "Verified administrator Google email" },
        "role": { "type": "string", "enum": ["superadmin", "admin"], "description": "Administrative role level" },
        "verifiedAt": { "type": "string", "maxLength": 50, "description": "Initial verification ISO timestamp" },
        "updatedAt": { "type": "string", "maxLength": 50, "description": "Last verification update ISO timestamp" }
      },
      "required": ["uid", "email", "role", "verifiedAt", "updatedAt"]
    },
    "admin_integrations": {
      "title": "Administrator Cloud Integrations Metadata",
      "description": "Non-secret integration state metadata (e.g. Google Drive account email and app folder ID; never stores OAuth tokens)",
      "type": "object",
      "properties": {
        "connectedEmail": { "type": "string", "maxLength": 254, "description": "Linked Google Drive account email or null" },
        "folderId": { "type": "string", "maxLength": 256, "description": "Google Drive app folder ID or null" },
        "folderName": { "type": "string", "maxLength": 200, "description": "Google Drive dedicated folder display name" },
        "connectedAt": { "type": "string", "maxLength": 50, "description": "Initial link ISO timestamp" },
        "lastVerifiedAt": { "type": "string", "maxLength": 50, "description": "Last successful OAuth verification ISO timestamp" },
        "updatedAt": { "type": "string", "maxLength": 50, "description": "Last metadata update ISO timestamp" },
        "disconnectedExplicitly": { "type": "boolean", "description": "Whether admin explicitly disconnected Drive" }
      },
      "required": ["folderName", "updatedAt", "disconnectedExplicitly"]
    },
    "site_config": {
      "title": "Site Configuration",
      "description": "Global website settings, text content, section visibility, theme colors, and sync manifest metadata",
      "type": "object",
      "properties": {
        "siteTitle": { "type": "string", "maxLength": 200, "description": "Platform main Arabic title" },
        "siteSubtitle": { "type": "string", "maxLength": 300, "description": "Platform subtitle" },
        "heroTitle": { "type": "string", "maxLength": 300, "description": "Hero section title" },
        "heroSubtitle": { "type": "string", "maxLength": 1000, "description": "Hero section subtitle" },
        "heroBadgeText": { "type": "string", "maxLength": 200, "description": "Hero welcome badge text" },
        "heroPrimaryBtnText": { "type": "string", "maxLength": 100, "description": "Primary hero CTA label" },
        "heroPrimaryBtnLink": { "type": "string", "maxLength": 500, "description": "Primary hero CTA destination" },
        "telegramBotLink": { "type": "string", "maxLength": 500, "description": "Telegram bot URL" },
        "telegramBotName": { "type": "string", "maxLength": 150, "description": "Telegram bot username" },
        "footerCopyright": { "type": "string", "maxLength": 500, "description": "Footer copyright line" },
        "footerAboutText": { "type": "string", "maxLength": 2000, "description": "Footer overview text" },
        "contactEmail": { "type": "string", "maxLength": 254, "description": "Contact email" },
        "contactPhone": { "type": "string", "maxLength": 60, "description": "Contact phone number" },
        "contactAddress": { "type": "string", "maxLength": 300, "description": "College address" },
        "siteLogoUrl": { "type": "string", "maxLength": 2000, "description": "Custom logo URL" },
        "heroBgUrl": { "type": "string", "maxLength": 2000, "description": "Hero background image URL" },
        "primaryColor": { "type": "string", "maxLength": 40, "description": "Primary theme accent color" },
        "seoTitle": { "type": "string", "maxLength": 200, "description": "SEO page title" },
        "seoDescription": { "type": "string", "maxLength": 500, "description": "SEO meta description" },
        "seoKeywords": { "type": "string", "maxLength": 500, "description": "SEO keywords" },
        "tickerSpeed": { "type": "string", "enum": ["slow", "normal", "fast"], "description": "News ticker animation speed" },
        "tickerTitle": { "type": "string", "maxLength": 150, "description": "News ticker live badge title" },
        "tickerInitialized": { "type": "boolean", "description": "Whether default ticker items have been seeded once" },
        "sectionVisibility": { "type": "object", "description": "ON/OFF visibility switches for website sections and components" },
        "buttons": { "type": "array", "description": "Landing/header quick action button definitions" },
        "schemaVersion": { "type": "number", "description": "Manifest schema version when docId is sync_manifest" },
        "updatedAt": { "type": "string", "maxLength": 50, "description": "Last update ISO timestamp" },
        "versions": { "type": "object", "description": "Per-collection incremental version numbers for Smart Cache delta sync" },
        "deleted": { "type": "object", "description": "Per-collection tombstone deletion records" },
        "modifiedTerms": { "type": "array", "description": "Recently updated medical term IDs for delta fetching" },
        "seededCollections": { "type": "object", "description": "Flags marking collections initialized or intentionally emptied by admin" }
      }
    },
    "articles": {
      "title": "Academic Articles",
      "description": "Published and draft university articles managed via Admin Dashboard",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Article document identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Article headline" },
        "subtitle": { "type": "string", "maxLength": 500, "description": "Optional subtitle" },
        "content": { "type": "string", "maxLength": 50000, "description": "Full article body text" },
        "coverImage": { "type": "string", "maxLength": 2000, "description": "Optional cover image HTTPS URL" },
        "category": { "type": "string", "maxLength": 100, "description": "Article category" },
        "tags": { "type": "array", "description": "Up to 30 topic tags" },
        "status": { "type": "string", "enum": ["draft", "published"], "description": "Editorial publication status" },
        "author": { "type": "string", "maxLength": 150, "description": "Article author name" },
        "createdAt": { "type": "string", "maxLength": 50, "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "maxLength": 50, "description": "Last update ISO timestamp" }
      },
      "required": ["title", "content"]
    },
    "videos": {
      "title": "Educational Videos",
      "description": "University educational video library metadata and playback links (never temporary blob URLs)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Video document identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Video title" },
        "description": { "type": "string", "maxLength": 5000, "description": "Video description" },
        "videoUrl": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "Persistent video playback URL or Drive preview URL" },
        "thumbnailUrl": { "type": "string", "maxLength": 4000, "description": "Optional thumbnail URL" },
        "duration": { "type": "string", "maxLength": 50, "description": "Formatted duration e.g. 12:30" },
        "order": { "type": "number", "description": "Display order index" },
        "visible": { "type": "boolean", "description": "Public visibility switch" },
        "fileType": { "type": "string", "maxLength": 100, "description": "MIME type or source type" },
        "createdAt": { "type": "string", "maxLength": 50, "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "maxLength": 50, "description": "Last update ISO timestamp" }
      },
      "required": ["title", "videoUrl"]
    },
    "subjects_data": {
      "title": "Academic Subjects",
      "description": "List of college courses, credit hours, descriptions, and lecture topic outlines",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Subject ID" },
        "nameAr": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Arabic subject name" },
