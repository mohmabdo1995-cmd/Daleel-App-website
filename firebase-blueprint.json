        "description": { "type": "string", "maxLength": 2000, "description": "Short description" },
        "overview": { "type": "string", "maxLength": 8000, "description": "Detailed academic overview" },
        "image": { "type": "string", "maxLength": 2000, "description": "Image URL" },
        "keyTopics": { "type": "array", "description": "Core syllabus topics" },
        "studyTips": { "type": "array", "description": "Subject-specific study tips" },
        "recommendedBooks": { "type": "array", "description": "Recommended textbook titles" },
