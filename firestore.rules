rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPrimaryAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'mohmabdo1995@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isPrimaryAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidOptionalHttpsUrl(val, maxLen) {
      return isValidString(val, 0, maxLen) && (val.size() == 0 || val.matches('^https?://.*'));
    }

    function isValidNonBlobUrl(val, minLen, maxLen) {
      return isValidString(val, minLen, maxLen) && !val.matches('^blob:.*');
    }

    // --- Validation Blueprints: Student Accounts & Private Subcollections ---
    function isValidUserPreferences(prefs) {
      return prefs is map &&
        prefs.keys().hasAll(['theme', 'notificationsEnabled', 'soundEnabled', 'defaultScheduleView', 'pomodoroWorkMinutes', 'pomodoroBreakMinutes', 'favoriteSubjects']) &&
        prefs.keys().hasOnly(['theme', 'notificationsEnabled', 'soundEnabled', 'defaultScheduleView', 'pomodoroWorkMinutes', 'pomodoroBreakMinutes', 'favoriteSubjects', 'savedResourceIds']) &&
        (prefs.theme == 'light' || prefs.theme == 'dark') &&
        prefs.notificationsEnabled is bool &&
        prefs.soundEnabled is bool &&
        (prefs.defaultScheduleView == 'calendar' || prefs.defaultScheduleView == 'list') &&
        prefs.pomodoroWorkMinutes is int && prefs.pomodoroWorkMinutes >= 1 && prefs.pomodoroWorkMinutes <= 120 &&
        prefs.pomodoroBreakMinutes is int && prefs.pomodoroBreakMinutes >= 1 && prefs.pomodoroBreakMinutes <= 60 &&
        prefs.favoriteSubjects is list && prefs.favoriteSubjects.size() <= 20 &&
        (prefs.favoriteSubjects.size() == 0 || prefs.favoriteSubjects[0] is string) &&
        (!('savedResourceIds' in prefs) || (
          prefs.savedResourceIds is list &&
          prefs.savedResourceIds.size() <= 100 &&
          (prefs.savedResourceIds.size() == 0 || prefs.savedResourceIds[0] is string)
        ));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'preferences', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'college', 'academicYear', 'authProvider', 'preferences', 'createdAt', 'updatedAt', 'lastLoginAt']) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        isValidString(data.email, 3, 254) &&
        isValidString(data.displayName, 1, 120) &&
        (!('photoURL' in data) || isValidString(data.photoURL, 0, 1000)) &&
        (!('college' in data) || isValidString(data.college, 0, 150)) &&
        (!('academicYear' in data) || isValidString(data.academicYear, 0, 80)) &&
        (!('authProvider' in data) || isValidString(data.authProvider, 0, 60)) &&
        isValidUserPreferences(data.preferences) &&
        isValidString(data.createdAt, 1, 50) &&
        isValidString(data.updatedAt, 1, 50) &&
        (!('lastLoginAt' in data) || isValidString(data.lastLoginAt, 0, 50));
    }

    function isValidLecture(data, userId, lectureId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'subject', 'date', 'time', 'dayOfWeek', 'priority', 'completed', 'notificationEnabled', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'subject', 'professor', 'hall', 'date', 'time', 'dayOfWeek', 'notes', 'priority', 'completed', 'notificationEnabled', 'createdAt']) &&
        isValidId(data.id) &&
        data.id == lectureId &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        isValidString(data.title, 1, 200) &&
        isValidString(data.subject, 1, 100) &&
        (!('professor' in data) || isValidString(data.professor, 0, 150)) &&
        (!('hall' in data) || isValidString(data.hall, 0, 150)) &&
        isValidString(data.date, 8, 20) &&
        isValidString(data.time, 4, 10) &&
        isValidString(data.dayOfWeek, 2, 30) &&
        (!('notes' in data) || isValidString(data.notes, 0, 1000)) &&
        (data.priority == 'high' || data.priority == 'medium' || data.priority == 'low') &&
        data.completed is bool &&
        data.notificationEnabled is bool &&
        data.createdAt is number;
    }

    function isValidGpaCourse(data, userId, courseId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'credits', 'gradePoint', 'gradeLetter']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'credits', 'gradePoint', 'gradeLetter']) &&
        isValidId(data.id) &&
        data.id == courseId &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        isValidString(data.name, 1, 150) &&
        data.credits is number && data.credits >= 1 && data.credits <= 12 &&
        data.gradePoint is number && data.gradePoint >= 0 && data.gradePoint <= 5 &&
        isValidString(data.gradeLetter, 1, 10);
    }

    function isValidPersonalResource(data, userId, resourceId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'url', 'subjectTag', 'category', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'description', 'url', 'subjectTag', 'category', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == resourceId &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        isValidString(data.title, 1, 200) &&
        (!('description' in data) || isValidString(data.description, 0, 1000)) &&
        isValidString(data.url, 8, 1000) &&
        data.url.matches('^https?://.*') &&
        isValidString(data.subjectTag, 1, 100) &&
        data.category in ['book', 'video', 'telegram', 'notes', 'summary'] &&
        isValidString(data.createdAt, 1, 50) &&
        isValidString(data.updatedAt, 1, 50);
    }

    function isValidSubjectProgress(data, userId, subjectId) {
      return data.keys().hasAll(['id', 'userId', 'subjectId', 'notes', 'completedTopicIds', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'subjectId', 'notes', 'completedTopicIds', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == subjectId &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        isValidString(data.subjectId, 1, 100) &&
        isValidString(data.notes, 0, 4000) &&
        data.completedTopicIds is list &&
        data.completedTopicIds.size() <= 100 &&
        (data.completedTopicIds.size() == 0 || data.completedTopicIds[0] is string) &&
        isValidString(data.updatedAt, 1, 50);
    }

    // --- Validation Blueprints: Admin, Integrations & CMS Collections ---
    function isValidAdminRecord(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'verifiedAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'verifiedAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == adminId &&
        isValidString(data.email, 3, 254) &&
        data.role in ['superadmin', 'admin'] &&
        isValidString(data.verifiedAt, 1, 50) &&
        isValidString(data.updatedAt, 1, 50);
    }

    function isValidAdminIntegration(data) {
      return data.keys().hasAll(['folderName', 'updatedAt', 'disconnectedExplicitly']) &&
        data.keys().hasOnly(['connectedEmail', 'folderId', 'folderName', 'connectedAt', 'lastVerifiedAt', 'updatedAt', 'disconnectedExplicitly']) &&
        (!('connectedEmail' in data) || data.connectedEmail == null || isValidString(data.connectedEmail, 0, 254)) &&
        (!('folderId' in data) || data.folderId == null || isValidString(data.folderId, 0, 256)) &&
        isValidString(data.folderName, 1, 200) &&
        (!('connectedAt' in data) || data.connectedAt == null || isValidString(data.connectedAt, 0, 50)) &&
        (!('lastVerifiedAt' in data) || data.lastVerifiedAt == null || isValidString(data.lastVerifiedAt, 0, 50)) &&
        isValidString(data.updatedAt, 1, 50) &&
        data.disconnectedExplicitly is bool;
    }

    function isValidSiteConfigGeneral(data) {
      return data is map &&
        data.keys().size() >= 1 &&
        data.keys().hasOnly([
          'siteTitle', 'siteSubtitle', 'heroTitle', 'heroSubtitle', 'heroBadgeText',
          'heroPrimaryBtnText', 'heroPrimaryBtnLink', 'telegramBotName', 'telegramBotLink',
          'contactEmail', 'contactPhone', 'contactAddress', 'footerCopyright', 'footerAboutText',
          'siteLogoUrl', 'heroBgUrl', 'primaryColor', 'seoTitle', 'seoDescription', 'seoKeywords',
          'sectionVisibility', 'buttons', 'tickerSpeed', 'tickerTitle', 'tickerInitialized', 'updatedAt'
        ]) &&
        (!('siteTitle' in data) || isValidString(data.siteTitle, 0, 200)) &&
        (!('siteSubtitle' in data) || isValidString(data.siteSubtitle, 0, 300)) &&
        (!('heroTitle' in data) || isValidString(data.heroTitle, 0, 300)) &&
        (!('heroSubtitle' in data) || isValidString(data.heroSubtitle, 0, 1000)) &&
        (!('heroBadgeText' in data) || isValidString(data.heroBadgeText, 0, 200)) &&
        (!('heroPrimaryBtnText' in data) || isValidString(data.heroPrimaryBtnText, 0, 100)) &&
        (!('heroPrimaryBtnLink' in data) || isValidString(data.heroPrimaryBtnLink, 0, 500)) &&
        (!('telegramBotName' in data) || isValidString(data.telegramBotName, 0, 150)) &&
        (!('telegramBotLink' in data) || isValidString(data.telegramBotLink, 0, 500)) &&
        (!('contactEmail' in data) || isValidString(data.contactEmail, 0, 254)) &&
        (!('contactPhone' in data) || isValidString(data.contactPhone, 0, 60)) &&
        (!('contactAddress' in data) || isValidString(data.contactAddress, 0, 300)) &&
        (!('footerCopyright' in data) || isValidString(data.footerCopyright, 0, 500)) &&
        (!('footerAboutText' in data) || isValidString(data.footerAboutText, 0, 2000)) &&
        (!('siteLogoUrl' in data) || isValidNonBlobUrl(data.siteLogoUrl, 0, 2000)) &&
        (!('heroBgUrl' in data) || isValidNonBlobUrl(data.heroBgUrl, 0, 2000)) &&
        (!('primaryColor' in data) || isValidString(data.primaryColor, 0, 40)) &&
        (!('seoTitle' in data) || isValidString(data.seoTitle, 0, 200)) &&
        (!('seoDescription' in data) || isValidString(data.seoDescription, 0, 500)) &&
        (!('seoKeywords' in data) || isValidString(data.seoKeywords, 0, 500)) &&
        (!('sectionVisibility' in data) || data.sectionVisibility is map) &&
        (!('buttons' in data) || (data.buttons is list && data.buttons.size() <= 20)) &&
        (!('tickerSpeed' in data) || data.tickerSpeed in ['slow', 'normal', 'fast']) &&
        (!('tickerTitle' in data) || isValidString(data.tickerTitle, 0, 150)) &&
        (!('tickerInitialized' in data) || data.tickerInitialized is bool) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 0, 50));
    }

    function isValidSyncManifest(data) {
      return data.keys().hasAll(['schemaVersion', 'updatedAt', 'versions']) &&
        data.keys().hasOnly(['schemaVersion', 'updatedAt', 'versions', 'deleted', 'modifiedTerms', 'seededCollections']) &&
        data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 100 &&
        isValidString(data.updatedAt, 1, 50) &&
        data.versions is map &&
        (!('deleted' in data) || data.deleted is map) &&
        (!('seededCollections' in data) || data.seededCollections is map) &&
        (!('modifiedTerms' in data) || (data.modifiedTerms is list && data.modifiedTerms.size() <= 150));
    }

    function isValidCollegeInfo(data) {
      return data is map &&
        data.keys().size() >= 1 &&
        data.keys().hasOnly(['title', 'tagline', 'image', 'overview', 'creditSystem', 'survivalTips', 'customSections', 'updatedAt']) &&
        (!('title' in data) || isValidString(data.title, 0, 300)) &&
        (!('tagline' in data) || isValidString(data.tagline, 0, 300)) &&
        (!('image' in data) || isValidNonBlobUrl(data.image, 0, 2000)) &&
        (!('overview' in data) || isValidString(data.overview, 0, 8000)) &&
        (!('creditSystem' in data) || isValidString(data.creditSystem, 0, 8000)) &&
        (!('survivalTips' in data) || (data.survivalTips is list && data.survivalTips.size() <= 100)) &&
        (!('customSections' in data) || (data.customSections is list && data.customSections.size() <= 50)) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 0, 50));
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['title', 'content']) &&
        data.keys().hasOnly(['id', 'title', 'subtitle', 'content', 'coverImage', 'category', 'tags', 'status', 'author', 'createdAt', 'updatedAt']) &&
        (!('id' in data) || isValidId(data.id)) &&
        isValidString(data.title, 1, 300) &&
        (!('subtitle' in data) || isValidString(data.subtitle, 0, 500)) &&
        isValidString(data.content, 1, 50000) &&
        (!('coverImage' in data) || isValidNonBlobUrl(data.coverImage, 0, 2000)) &&
        (!('category' in data) || isValidString(data.category, 0, 100)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 30 && (data.tags.size() == 0 || data.tags[0] is string))) &&
        (!('status' in data) || data.status in ['draft', 'published']) &&
        (!('author' in data) || isValidString(data.author, 0, 150)) &&
        (!('createdAt' in data) || isValidString(data.createdAt, 0, 50)) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 0, 50));
    }

    function isValidVideo(data) {
      return data.keys().hasAll(['title', 'videoUrl']) &&
        data.keys().hasOnly(['id', 'title', 'description', 'videoUrl', 'thumbnailUrl', 'duration', 'order', 'visible', 'fileType', 'createdAt', 'updatedAt']) &&
        (!('id' in data) || isValidId(data.id)) &&
        isValidString(data.title, 1, 300) &&
        (!('description' in data) || isValidString(data.description, 0, 5000)) &&
        isValidNonBlobUrl(data.videoUrl, 1, 4000) &&
        (!('thumbnailUrl' in data) || isValidNonBlobUrl(data.thumbnailUrl, 0, 4000)) &&
        (!('duration' in data) || isValidString(data.duration, 0, 50)) &&
        (!('order' in data) || data.order is number) &&
        (!('visible' in data) || data.visible is bool) &&
        (!('fileType' in data) || isValidString(data.fileType, 0, 100)) &&
        (!('createdAt' in data) || isValidString(data.createdAt, 0, 50)) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 0, 50));
    }

    function isValidSubject(data, subjectId) {
      return data.keys().hasAll(['id', 'nameAr']) &&
        data.keys().hasOnly(['id', 'nameAr', 'nameEn', 'code', 'icon', 'color', 'image', 'description', 'credits', 'overview', 'keyTopics', 'studyTips', 'recommendedBooks', 'lectureTopics', 'visible', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == subjectId &&
        isValidString(data.nameAr, 1, 200) &&
        (!('nameEn' in data) || isValidString(data.nameEn, 0, 200)) &&
        (!('code' in data) || isValidString(data.code, 0, 50)) &&
        (!('icon' in data) || isValidString(data.icon, 0, 80)) &&
        (!('color' in data) || isValidString(data.color, 0, 60)) &&
        (!('image' in data) || isValidNonBlobUrl(data.image, 0, 2000)) &&
        (!('description' in data) || isValidString(data.description, 0, 2000)) &&
        (!('credits' in data) || (data.credits is number && data.credits >= 0 && data.credits <= 30)) &&
        (!('overview' in data) || isValidString(data.overview, 0, 8000)) &&
        (!('keyTopics' in data) || (data.keyTopics is list && data.keyTopics.size() <= 100)) &&
        (!('studyTips' in data) || (data.studyTips is list && data.studyTips.size() <= 100)) &&
        (!('recommendedBooks' in data) || (data.recommendedBooks is list && data.recommendedBooks.size() <= 100)) &&
        (!('lectureTopics' in data) || (data.lectureTopics is list && data.lectureTopics.size() <= 200)) &&
        (!('visible' in data) || data.visible is bool) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 0, 50));
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'content']) &&
        data.keys().hasOnly(['id', 'title', 'content', 'badge', 'link', 'visible', 'createdAt', 'updatedAt']) &&
        (!('id' in data) || isValidId(data.id)) &&
        isValidString(data.title, 1, 300) &&
        isValidString(data.content, 0, 5000) &&
        (!('badge' in data) || isValidString(data.badge, 0, 60)) &&
        (!('link' in data) || isValidString(data.link, 0, 1000)) &&
        (!('visible' in data) || data.visible is bool) &&
        (!('createdAt' in data) || isValidString(data.createdAt, 0, 50)) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 0, 50));
    }

    function isValidMedia(data) {
      return data.keys().hasAll(['name', 'url']) &&
        data.keys().hasOnly(['id', 'name', 'url', 'type', 'size', 'category', 'visible', 'createdAt', 'updatedAt']) &&
        (!('id' in data) || isValidId(data.id)) &&
        isValidString(data.name, 1, 300) &&
        isValidNonBlobUrl(data.url, 1, 4000) &&
        (!('type' in data) || data.type in ['image', 'pdf', 'video', 'logo']) &&
        (!('size' in data) || isValidString(data.size, 0, 60)) &&
        (!('category' in data) || isValidString(data.category, 0, 100)) &&
        (!('visible' in data) || data.visible is bool) &&
        (!('createdAt' in data) || isValidString(data.createdAt, 0, 50)) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 0, 50));
    }

    function isValidTickerItem(data) {
      return data.keys().hasAll(['text']) &&
        data.keys().hasOnly(['id', 'text', 'badge', 'link', 'visible', 'order', 'createdAt', 'updatedAt']) &&
        (!('id' in data) || isValidId(data.id)) &&
        isValidString(data.text, 1, 1000) &&
        (!('badge' in data) || isValidString(data.badge, 0, 40)) &&
        (!('link' in data) || isValidString(data.link, 0, 500)) &&
        (!('visible' in data) || data.visible is bool) &&
        (!('order' in data) || data.order is number) &&
        (!('createdAt' in data) || isValidString(data.createdAt, 0, 50)) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 0, 50));
    }

    function isValidDriveFile(data, docId) {
      return data.keys().hasAll(['id', 'fileId', 'name', 'previewUrl']) &&
        data.keys().hasOnly(['id', 'fileId', 'name', 'mimeType', 'sizeBytes', 'sizeFormatted', 'previewUrl', 'downloadUrl', 'thumbnailUrl', 'category', 'subject', 'uploadedAt', 'updatedAt', 'uploadedBy']) &&
        isValidId(data.id) &&
        data.id == docId &&
        isValidString(data.fileId, 1, 200) &&
        isValidString(data.name, 1, 300) &&
        (!('mimeType' in data) || isValidString(data.mimeType, 0, 150)) &&
        (!('sizeBytes' in data) || (data.sizeBytes is number && data.sizeBytes >= 0)) &&
        (!('sizeFormatted' in data) || isValidString(data.sizeFormatted, 0, 60)) &&
        isValidNonBlobUrl(data.previewUrl, 8, 1000) &&
        (!('downloadUrl' in data) || isValidNonBlobUrl(data.downloadUrl, 0, 1000)) &&
        (!('thumbnailUrl' in data) || isValidNonBlobUrl(data.thumbnailUrl, 0, 1000)) &&
        (!('category' in data) || data.category in ['video', 'pdf', 'image', 'other']) &&
        (!('subject' in data) || isValidString(data.subject, 0, 120)) &&
        (!('uploadedAt' in data) || isValidString(data.uploadedAt, 0, 50)) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 0, 50)) &&
        (!('uploadedBy' in data) || isValidString(data.uploadedBy, 0, 254));
    }

    function isValidStudyResource(data) {
      return data.keys().hasAll(['title', 'description']) &&
        data.keys().hasOnly(['id', 'title', 'subjectId', 'subjectTag', 'category', 'description', 'link', 'url', 'isExternal', 'icon', 'order', 'isActive', 'createdAt', 'updatedAt']) &&
        (!('id' in data) || isValidId(data.id)) &&
        isValidString(data.title, 1, 300) &&
        isValidString(data.description, 0, 4000) &&
        (!('subjectId' in data) || isValidString(data.subjectId, 0, 120)) &&
        (!('subjectTag' in data) || isValidString(data.subjectTag, 0, 120)) &&
        (!('category' in data) || isValidString(data.category, 0, 60)) &&
        (!('link' in data) || isValidNonBlobUrl(data.link, 0, 2000)) &&
        (!('url' in data) || isValidNonBlobUrl(data.url, 0, 2000)) &&
        (!('isExternal' in data) || data.isExternal is bool) &&
        (!('icon' in data) || isValidString(data.icon, 0, 80)) &&
        (!('order' in data) || data.order is number) &&
        (!('isActive' in data) || data.isActive is bool) &&
        (!('createdAt' in data) || isValidString(data.createdAt, 0, 50)) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 0, 50));
    }

    function isValidMedicalTerm(data, termId) {
      return data.keys().hasAll(['id', 'term_en', 'term_en_lower', 'term_ar', 'synonyms', 'pronunciation', 'ipa', 'english_definition', 'arabic_definition', 'specialty', 'sources', 'verification_status', 'last_verified', 'search_tokens', 'created_at', 'updated_at']) &&
        data.keys().hasOnly(['id', 'term_en', 'term_en_lower', 'term_ar', 'synonyms', 'pronunciation', 'ipa', 'audio_url', 'english_definition', 'arabic_definition', 'specialty', 'sources', 'verification_status', 'last_verified', 'search_tokens', 'created_at', 'updated_at']) &&
        isValidId(data.id) &&
        data.id == termId &&
        isValidString(data.term_en, 2, 200) &&
        isValidString(data.term_en_lower, 2, 200) &&
        isValidString(data.term_ar, 2, 200) &&
        data.synonyms is list &&
        data.synonyms.size() <= 25 &&
        (data.synonyms.size() == 0 || data.synonyms[0] is string) &&
        isValidString(data.pronunciation, 0, 200) &&
        isValidString(data.ipa, 0, 200) &&
        (!('audio_url' in data) || (
          isValidString(data.audio_url, 0, 1000) &&
          (data.audio_url.size() == 0 || data.audio_url.matches('^https://.*'))
        )) &&
        isValidString(data.english_definition, 10, 3000) &&
        isValidString(data.arabic_definition, 10, 3000) &&
        isValidString(data.specialty, 2, 100) &&
        data.sources is list &&
        data.sources.size() >= 1 &&
        data.sources.size() <= 10 &&
        data.sources[0] is map &&
        isValidString(data.sources[0].name, 1, 150) &&
        isValidString(data.sources[0].url, 8, 1000) &&
        data.sources[0].url.matches('^https://.*') &&
        data.verification_status in ['verified', 'needs_review', 'draft'] &&
        isValidString(data.last_verified, 4, 30) &&
        data.search_tokens is list &&
        data.search_tokens.size() <= 60 &&
        (data.search_tokens.size() == 0 || data.search_tokens[0] is string) &&
        isValidString(data.created_at, 1, 50) &&
        isValidString(data.updated_at, 1, 50);
    }

    function isValidInnovaInfo(data, infoId) {
      return data.keys().hasAll(['id', 'aboutTitle', 'aboutDescription', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'aboutTitle', 'aboutDescription', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == infoId &&
        isValidString(data.aboutTitle, 1, 200) &&
        isValidString(data.aboutDescription, 0, 5000) &&
        isValidString(data.createdAt, 1, 50) &&
        isValidString(data.updatedAt, 1, 50);
    }

    function isValidInnovaMember(data, memberId) {
      return data.keys().hasAll(['id', 'name', 'position', 'photoUrl', 'order', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'position', 'photoUrl', 'photoStoragePath', 'order', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == memberId &&
        isValidString(data.name, 2, 150) &&
        isValidString(data.position, 2, 150) &&
        isValidOptionalHttpsUrl(data.photoUrl, 2000) &&
        (!('photoStoragePath' in data) || isValidString(data.photoStoragePath, 0, 500)) &&
        data.order is number && data.order >= 0 && data.order <= 10000 &&
        isValidString(data.createdAt, 1, 50) &&
        isValidString(data.updatedAt, 1, 50);
    }

    function isValidInnovaContent(data, contentId) {
      return data.keys().hasAll(['id', 'category', 'title', 'description', 'imageUrl', 'published', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'category', 'title', 'description', 'imageUrl', 'imageStoragePath', 'published', 'eventDate', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == contentId &&
        data.category in ['articles', 'events'] &&
        isValidString(data.title, 2, 250) &&
        isValidString(data.description, 2, 8000) &&
        isValidOptionalHttpsUrl(data.imageUrl, 2000) &&
        (!('imageStoragePath' in data) || isValidString(data.imageStoragePath, 0, 500)) &&
        data.published is bool &&
        (!('eventDate' in data) || isValidString(data.eventDate, 0, 40)) &&
        isValidString(data.createdAt, 1, 50) &&
        isValidString(data.updatedAt, 1, 50);
    }

    // --- Admin Access Control & Integrations (Strict Admin Only) ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isVerifiedUser() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(adminId) && isAdmin() && isValidAdminRecord(incoming(), adminId);
      allow delete: if isValidId(adminId) && isAdmin() && adminId != request.auth.uid;
    }

    match /admin_integrations/{integrationId} {
      allow get: if isValidId(integrationId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(integrationId) && isAdmin() && isValidAdminIntegration(incoming());
      allow delete: if isValidId(integrationId) && isAdmin();
    }

    match /admin_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() &&
        incoming().keys().hasAll(['action', 'timestamp']) &&
        incoming().keys().hasOnly(['action', 'details', 'timestamp']) &&
        isValidString(incoming().action, 1, 200) &&
        (!('details' in incoming()) || isValidString(incoming().details, 0, 2000)) &&
        isValidString(incoming().timestamp, 1, 50);
      allow update, delete: if false;
    }

    // --- Private User Account Data (Strict Owner Isolation & PII Protection) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isVerifiedUser() &&
        isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId) && isOwner(userId) && isVerifiedUser() &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        (!('authProvider' in existing()) || incoming().authProvider == existing().authProvider) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'college', 'academicYear', 'preferences', 'updatedAt', 'lastLoginAt']);
      allow delete: if isValidId(userId) && isOwner(userId) && isVerifiedUser();

      match /lectures/{lectureId} {
        allow get: if isValidId(userId) && isValidId(lectureId) && (isOwner(userId) || isAdmin());
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isAdmin();
        allow create: if isValidId(userId) && isValidId(lectureId) && isOwner(userId) && isVerifiedUser() &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidLecture(incoming(), userId, lectureId);
        allow update: if isValidId(userId) && isValidId(lectureId) && isOwner(userId) && isVerifiedUser() &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidLecture(incoming(), userId, lectureId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subject', 'professor', 'hall', 'date', 'time', 'dayOfWeek', 'notes', 'priority', 'completed', 'notificationEnabled']);
        allow delete: if isValidId(userId) && isValidId(lectureId) && isOwner(userId) && isVerifiedUser();
      }

      match /gpa_courses/{courseId} {
        allow get: if isValidId(userId) && isValidId(courseId) && (isOwner(userId) || isAdmin());
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isAdmin();
        allow create: if isValidId(userId) && isValidId(courseId) && isOwner(userId) && isVerifiedUser() &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidGpaCourse(incoming(), userId, courseId);
        allow update: if isValidId(userId) && isValidId(courseId) && isOwner(userId) && isVerifiedUser() &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidGpaCourse(incoming(), userId, courseId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'credits', 'gradePoint', 'gradeLetter']);
        allow delete: if isValidId(userId) && isValidId(courseId) && isOwner(userId) && isVerifiedUser();
      }

      match /personal_resources/{resourceId} {
        allow get: if isValidId(userId) && isValidId(resourceId) && (isOwner(userId) || isAdmin());
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isAdmin();
        allow create: if isValidId(userId) && isValidId(resourceId) && isOwner(userId) && isVerifiedUser() &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidPersonalResource(incoming(), userId, resourceId);
        allow update: if isValidId(userId) && isValidId(resourceId) && isOwner(userId) && isVerifiedUser() &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidPersonalResource(incoming(), userId, resourceId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'url', 'subjectTag', 'category', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(resourceId) && isOwner(userId) && isVerifiedUser();
      }

      match /subject_progress/{subjectId} {
        allow get: if isValidId(userId) && isValidId(subjectId) && (isOwner(userId) || isAdmin());
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isAdmin();
        allow create: if isValidId(userId) && isValidId(subjectId) && isOwner(userId) && isVerifiedUser() &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidSubjectProgress(incoming(), userId, subjectId);
        allow update: if isValidId(userId) && isValidId(subjectId) && isOwner(userId) && isVerifiedUser() &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidSubjectProgress(incoming(), userId, subjectId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().subjectId == existing().subjectId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'completedTopicIds', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(subjectId) && isOwner(userId) && isVerifiedUser();
      }
    }

    // --- Publicly Readable, Strictly Admin-Managed CMS & Catalog Collections ---
    match /site_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow create, update: if isValidId(configId) && isAdmin() && (
        (configId == 'general' && isValidSiteConfigGeneral(incoming())) ||
        (configId == 'sync_manifest' && isValidSyncManifest(incoming()))
      );
      allow delete: if isValidId(configId) && isAdmin();
    }

    match /college_info/{infoId} {
      allow get: if isValidId(infoId);
      allow list: if true;
      allow create, update: if isValidId(infoId) && isAdmin() && isValidCollegeInfo(incoming());
      allow delete: if isValidId(infoId) && isAdmin();
    }

    match /articles/{articleId} {
      allow get: if isValidId(articleId);
      allow list: if true;
      allow create, update: if isValidId(articleId) && isAdmin() && isValidArticle(incoming());
      allow delete: if isValidId(articleId) && isAdmin();
    }

    match /videos/{videoId} {
      allow get: if isValidId(videoId);
      allow list: if true;
      allow create, update: if isValidId(videoId) && isAdmin() && isValidVideo(incoming());
      allow delete: if isValidId(videoId) && isAdmin();
    }

    match /subjects_data/{subjectId} {
      allow get: if isValidId(subjectId);
      allow list: if true;
      allow create, update: if isValidId(subjectId) && isAdmin() && isValidSubject(incoming(), subjectId);
      allow delete: if isValidId(subjectId) && isAdmin();
    }

    match /announcements/{annId} {
      allow get: if isValidId(annId);
      allow list: if true;
      allow create, update: if isValidId(annId) && isAdmin() && isValidAnnouncement(incoming());
      allow delete: if isValidId(annId) && isAdmin();
    }

    match /media/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if true;
      allow create, update: if isValidId(mediaId) && isAdmin() && isValidMedia(incoming());
      allow delete: if isValidId(mediaId) && isAdmin();
    }

    match /ticker_items/{tickerId} {
      allow get: if isValidId(tickerId);
      allow list: if true;
      allow create, update: if isValidId(tickerId) && isAdmin() && isValidTickerItem(incoming());
      allow delete: if isValidId(tickerId) && isAdmin();
    }

    match /drive_files/{fileId} {
      allow get: if isValidId(fileId);
      allow list: if true;
      allow create, update: if isValidId(fileId) && isAdmin() && isValidDriveFile(incoming(), fileId);
      allow delete: if isValidId(fileId) && isAdmin();
    }

    match /study_resources/{resourceId} {
      allow get: if isValidId(resourceId);
      allow list: if true;
      allow create, update: if isValidId(resourceId) && isAdmin() && isValidStudyResource(incoming());
      allow delete: if isValidId(resourceId) && isAdmin();
    }

    match /medical_terms/{termId} {
      allow get: if isValidId(termId) && (existing().verification_status == 'verified' || isAdmin());
      allow list: if existing().verification_status == 'verified' || isAdmin();
      allow create: if isValidId(termId) && isAdmin() && isValidMedicalTerm(incoming(), termId);
      allow update: if isValidId(termId) && isAdmin() &&
        isValidMedicalTerm(incoming(), termId) &&
        incoming().id == existing().id &&
        incoming().created_at == existing().created_at &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'term_en',
          'term_en_lower',
          'term_ar',
          'synonyms',
          'pronunciation',
          'ipa',
          'audio_url',
          'english_definition',
          'arabic_definition',
          'specialty',
          'sources',
          'verification_status',
          'last_verified',
          'search_tokens',
          'updated_at'
        ]);
      allow delete: if isValidId(termId) && isAdmin();
    }

    // --- INNOVA Association Collections (Public Read, Strict Verified Admin Write) ---
    match /innova_info/{infoId} {
      allow get: if isValidId(infoId);
      allow list: if true;
      allow create: if isValidId(infoId) && isAdmin() && isValidInnovaInfo(incoming(), infoId);
      allow update: if isValidId(infoId) && isAdmin() &&
        isValidInnovaInfo(incoming(), infoId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['aboutTitle', 'aboutDescription', 'updatedAt']);
      allow delete: if isValidId(infoId) && isAdmin();
    }

    match /innova_members/{memberId} {
      allow get: if isValidId(memberId);
      allow list: if true;
      allow create: if isValidId(memberId) && isAdmin() && isValidInnovaMember(incoming(), memberId);
      allow update: if isValidId(memberId) && isAdmin() &&
        isValidInnovaMember(incoming(), memberId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'position', 'photoUrl', 'photoStoragePath', 'order', 'updatedAt']);
      allow delete: if isValidId(memberId) && isAdmin();
    }

    match /innova_contents/{contentId} {
      allow get: if isValidId(contentId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();
      allow create: if isValidId(contentId) && isAdmin() && isValidInnovaContent(incoming(), contentId);
      allow update: if isValidId(contentId) && isAdmin() &&
        isValidInnovaContent(incoming(), contentId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['category', 'title', 'description', 'imageUrl', 'imageStoragePath', 'published', 'eventDate', 'updatedAt']);
      allow delete: if isValidId(contentId) && isAdmin();
    }
  }
}
